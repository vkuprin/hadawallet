#!/usr/bin/env bash
# Runs the project lint on every commit that touches Ada / project files.
# Install with: ./scripts/install-hooks.sh
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! git diff --cached --name-only --diff-filter=ACM \
     | grep -qE '\.(adb|ads|gpr|toml)$'; then
  exit 0
fi

./scripts/lint.sh
