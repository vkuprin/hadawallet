project Hadawallet is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-g",            --  debug info
         "-O0",           --  no optimization for dev
         "-gnatwa",       --  all warnings
         "-gnatVa",       --  all validity checks
         "-gnata",        --  assertions enabled
         "-gnat2022");    --  Ada 2022
   end Compiler;

   package Builder is
      for Executable ("main.adb") use "hadawallet";
   end Builder;

   package Binder is
      for Switches ("Ada") use ("-Es");  --  symbolic traceback
   end Binder;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=1",        --  baseline; raise to 4 by week 4
         "--report=fail",
         "--mode=all");
   end Prove;

end Hadawallet;
