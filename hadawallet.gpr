project Hadawallet is

   for Languages use ("Ada");

   --  Backend selection: "c" (default) links libsecp256k1; "ada" wires
   --  the Signing body to the in-tree pure-SPARK secp256k1 module
   --  (Phase D — currently a stub-quality skeleton; see plan).
   type Backend_Type is ("c", "ada");
   Backend : Backend_Type := external ("BACKEND", "c");

   --  Source layout: shared modules live in src/ and src/secp256k1/;
   --  the Signing body alternates between src/backend_c/ (FFI) and
   --  src/backend_ada/ (pure-SPARK). The src/stm32/ tree belongs to
   --  hadawallet_stm32.gpr only.
   case Backend is
      when "c"   => for Source_Dirs use ("src", "src/secp256k1",
                                          "src/backend_c");
      when "ada" => for Source_Dirs use ("src", "src/secp256k1",
                                          "src/backend_ada");
   end case;
   for Excluded_Source_Dirs use ("src/stm32");

   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("main.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-g",            --  debug info
         "-O0",           --  no optimization for dev
         "-gnatwa",       --  all warnings
         "-gnatVa",       --  all validity checks
         "-gnata",        --  assertions enabled
         "-gnat2022");    --  Ada 2022
   end Compiler;

   package Builder is
      for Executable ("main.adb") use "hadawallet";
   end Builder;

   package Binder is
      for Switches ("Ada") use ("-Es");  --  symbolic traceback
   end Binder;

   package Linker is
      case Backend is
         when "c" =>
            for Switches ("Ada") use
              ("-L/opt/homebrew/lib",   --  macOS Homebrew prefix
               "-L/usr/local/lib",      --  Linux distro default
               "-lsecp256k1");          --  Bitcoin Core reference impl
         when "ada" =>
            --  Pure-SPARK backend: no C library is linked.
            for Switches ("Ada") use ();
      end case;
   end Linker;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=1",        --  baseline; raise to 4 by week 4
         "--report=fail",
         "--mode=all");
   end Prove;

end Hadawallet;
