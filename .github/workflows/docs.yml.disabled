name: docs

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Setup Alire
        uses: alire-project/setup-alire@v3

      - name: Cache Alire toolchains and builds
        uses: actions/cache@v4
        with:
          path: |
            ~/.cache/alire
            ~/.local/share/alire
            ~/.alire
          key: alire-${{ runner.os }}-${{ hashFiles('alire.toml', 'alire/alire.lock') }}
          restore-keys: |
            alire-${{ runner.os }}-

      - name: Install gnatdoc (direct from GNAT-FSF-builds release)
        run: |
          set -euo pipefail
          GNATDOC_VERSION="26.0.0-1"
          ASSET="gnatdoc-x86_64-linux-${GNATDOC_VERSION}.tar.gz"
          URL="https://github.com/alire-project/GNAT-FSF-builds/releases/download/gnatdoc-${GNATDOC_VERSION}/${ASSET}"
          mkdir -p "$HOME/.local/gnatdoc"
          curl -fsSL "$URL" | tar -xz -C "$HOME/.local/gnatdoc" --strip-components=1
          echo "$HOME/.local/gnatdoc/bin" >> "$GITHUB_PATH"
          "$HOME/.local/gnatdoc/bin/gnatdoc" --version || true
        # We bypass `alr install gnatdoc_bin` because setup-alire@v3 ships an
        # older alr whose snapshot catalog doesn't have gnatdoc_bin 26.0.0
        # ("Could not find a complete solution for gnatdoc_bin*"). The
        # tarball below is the *same* artifact Alire would have fetched —
        # we just skip the resolution layer.

      - name: Generate docs
        run: ./scripts/docs.sh

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: docs

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
